{
  "manifest_version": 3,
  "name": "Browser Assistant",
  "short_name": "BAssistant",
  "version": "1.0.0",
  "description": "Память вкладок с закрытием по клику, экстрактор ссылок по форматам файлов и анонимайзер заголовков/отпечатков браузера.",
  "minimum_chrome_version": "110",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "webRequest",
    "processes",
    "notifications",
    "downloads"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "https://live.vkvideo.ru/*",
    "https://*.vkvideo.ru/*",
    "https://api.live.vkvideo.ru/*",
    "https://api.live.vkplay.ru/*",
    "https://www.twitch.tv/*",
    "https://*.twitch.tv/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://live.vkvideo.ru/*",
        "https://*.vkvideo.ru/*",
        "https://www.twitch.tv/*"
      ],
      "js": [
        "vkpoints/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Browser Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}